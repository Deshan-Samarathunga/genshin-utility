{
  "name": "genshin-impact-utility",
  "private": true,
  "version": "1.0.0",
  "description": "Genshin Impact Utility by Frost — AutoHotkey automation scripts with an Electron GUI",
  "author": "Frost",
  "main": "electron_main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.frost.genshinutility",
    "productName": "Genshin Impact Utility",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "icon.png"
    },
    "portable": {
      "artifactName": "GenshinImpactUtility-${version}.exe"
    },
    "extraResources": [
      {
        "from": "../ahk",
        "to": "ahk",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
