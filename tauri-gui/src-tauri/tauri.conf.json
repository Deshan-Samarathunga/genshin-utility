{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Genshin Impact Utility",
  "mainBinaryName": "Genshin Impact Utility",
  "version": "1.1.0",
  "identifier": "com.frost.genshinutility",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Genshin Impact Utility",
        "width": 900,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
